# TUDO OPCIONAL: sem .env o projeto roda com banco embutido e segredo gerado automaticamente.
# PORT=3000
# JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# JWT_EXPIRES=2h
# NODE_ENV=production        # desliga contas de demonstração

# Só se quiser usar um PostgreSQL próprio em vez do embutido:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/pratofeito
# (ou) DB_HOST=localhost  DB_PORT=5432  DB_USER=postgres  DB_PASS=postgres  DB_NAME=pratofeito

# Só se o site for hospedado em OUTRO endereço que a API:
# FRONTEND_ORIGIN=http://localhost:5500
